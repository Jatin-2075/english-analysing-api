server {
    listen 80;
    server_name your-domain.com;          # change this
    # After this works, run: sudo certbot --nginx -d your-domain.com
    # The microphone only works on HTTPS (or localhost).

    root /var/www/verba;                  # where you copy the dist/ files
    index index.html;

    client_max_body_size 50M;             # audio uploads

    location / {
        try_files $uri /index.html;
    }

    # /api/transcribe -> http://127.0.0.1:8000/transcribe
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;          # Whisper can be slow
        proxy_send_timeout 300s;
    }
}
